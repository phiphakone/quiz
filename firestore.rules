rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (request.auth.uid == 'fmkw0LyA8yWYYZBbePmDx3g5JWE2' || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true));
    }
    function text(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function money(v) { return v is number && v >= 0 && v <= 100000000000; }
    function validItem(i) {
      return i is map && i.keys().hasAll(['id','name','price','qty','image'])
        && text(i.id,1,100) && text(i.name,1,300)
        && i.price is number && i.price > 0
        && i.qty is int && i.qty > 0 && i.qty <= 999
        && i.image is string && i.image.size() <= 300 && !i.image.matches('data:.*');
    }
    function validItems(items) {
      return items is list && items.size() > 0 && items.size() <= 20
        && (items.size() <= 0 || validItem(items[0]))
        && validItem(items[items.size() - 1]);
    }
    function itemAmount(items, n) { return items.size() > n ? items[n].price * items[n].qty : 0; }
    function subtotal(items) { return itemAmount(items, 0) + itemAmount(items, 1) + itemAmount(items, 2) + itemAmount(items, 3) + itemAmount(items, 4); }
    function customer(c, o) {
      return c is map && c.keys().hasAll(['name','phone','addr','email','city','country','note'])
        && c.keys().hasOnly(['name','phone','addr','email','city','country','note'])
        && c.name == o.name && c.phone == o.phone && c.addr == o.address
        && text(c.email,0,254) && text(c.city,0,150)
        && text(c.country,0,100) && text(c.note,0,2000);
    }
    function validSlip(o) {
      return (o.payMethod in ['cod','card'] && o.slipUrl == '' && o.slipPath == ''
          && o.slipName == '' && o.slipType == '' && o.slipSize == 0 && o.slipUploadedAt == null)
        || (o.payMethod in ['bank-vn','bcel','qr']
          && text(o.slipUrl,1,2000)
          && o.slipUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/lotus-1a491[.]firebasestorage[.]app/o/.*')
          && text(o.slipPath,1,500)
          && o.slipPath.matches('payment-slips/' + request.auth.uid + '/[^/]+')
          && text(o.slipName,1,255) && o.slipType in ['image/jpeg','image/png','image/webp','image/gif']
          && o.slipSize is int && o.slipSize > 0 && o.slipSize <= 8 * 1024 * 1024
          && text(o.slipUploadedAt,1,50));
    }
    function validOrder(o) {
      return o.keys().hasAll(['ownerUid','name','phone','address','customer','items','subtotal','shipFee','discount','total','shipMethod','payMethod','coupon','status','paymentStatus','slipUrl','slipPath','slipName','slipType','slipSize','slipUploadedAt','createdAt'])
        && o.keys().hasOnly(['ownerUid','name','phone','address','customer','items','subtotal','shipFee','discount','total','shipMethod','payMethod','coupon','status','paymentStatus','slipUrl','slipPath','slipName','slipType','slipSize','slipUploadedAt','createdAt'])
        && o.ownerUid == request.auth.uid && o.createdAt == request.time
        && text(o.name,1,150) && text(o.phone,3,40) && text(o.address,1,1000)
        && customer(o.customer,o) && validItems(o.items)
        && money(o.subtotal) && o.subtotal > 0
        && money(o.shipFee) && money(o.discount) && o.discount <= o.subtotal
        && money(o.total) && o.total == o.subtotal - o.discount + o.shipFee
        && o.shipMethod in ['vn','lao','pickup','contact']
        && o.payMethod in ['cod','bank-vn','bcel','qr','card']
        && (o.coupon == null || text(o.coupon,1,100))
        && o.status == 'pending' && o.paymentStatus == 'pending' && validSlip(o);
    }
    match /orders/{orderId} {
      allow create: if signedIn() && validOrder(request.resource.data);
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','paymentReviewedAt'])
        && request.resource.data.status in ['pending','confirmed','shipped','completed','cancelled']
        && request.resource.data.paymentStatus in ['pending','paid','rejected']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentReviewedAt'])
          || request.resource.data.paymentReviewedAt == request.time);
      allow delete: if admin();
    }
    function validProfile(p, uid) {
      return p.keys().hasAll(['uid','name','email','phone','createdAt'])
        && p.keys().hasOnly(['uid','name','email','phone','createdAt'])
        && p.uid == uid && text(p.name,1,150) && text(p.email,1,254)
        && p.email == request.auth.token.email && text(p.phone,0,40);
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data,uid) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data,uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    // Create admin roles ONLY from Firebase Console / a trusted Admin SDK.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

